
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "raushankumarray96@gmail.com" ||
        request.auth.token.email.lower() == "admin@npbmedia.com"
      );
    }
    
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /careers/{careerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
    
    match /jobApplications/{applicationId} {
      // Admins can manage everything in the recruitment pipeline
      allow read, list, write: if isAdmin();
      
      // Users can create their own applications
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      
      // Users can only read their own applications
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Allow updates for specific hiring fields if admin (already covered by line 36, but for clarity)
      allow update: if isAdmin();
    }
  }
}
