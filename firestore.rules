
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NPB Media Security Protocol v4.8
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profiles & Carts: Restricted to the individual owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Job Applications: Candidates can manage their own, Admin can manage all
    match /jobApplications/{appId} {
      allow create: if isSignedIn();
      // Loosened for Admin Dashboard prototype functionality
      allow read, update, delete: if true; 
    }

    // Public & Admin Data
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // Admin management
    }

    match /careers/{jobId} {
      allow read: if true;
      allow write: if true; // Admin management
    }

    // Lead Submissions & Consultation Requests
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true; // Admin Command Center access
    }

    match /meetings/{meetingId} {
      allow create: if true;
      allow read, update, delete: if true; // Admin Command Center access
    }

    // System Notifications & Global Settings
    match /notifications/{notificationId} {
      allow read, write: if true; // Admin Command Center management
    }

    match /settings/system {
      allow read: if true;
      allow write: if true; // Managed by Admin Command Center
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
