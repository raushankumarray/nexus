
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Firebase Permission System
     * Standardized security rules for public user ecosystem.
     */

    // Basic check: Is the user logged in?
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Ownership check: Is this the user's own data?
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // PUBLIC ACCESS RULES
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /careers/{careerId} {
      allow read: if true;
      allow write: if false; // Admin functionality decommissioned
    }
    
    match /jobApplications/{applicationId} {
      allow create: if isSignedIn();
      allow read, list, write: if (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, list, write: if false; // Admin functionality decommissioned
    }

    match /meetings/{meetingId} {
      allow create: if true;
      allow read, list, write: if false; // Admin functionality decommissioned
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
