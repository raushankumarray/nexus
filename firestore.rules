
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == "raushankumarray96@gmail.com" ||
        request.auth.token.email.lower() == "admin@npbmedia.com"
      );
    }
    
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
    
    match /careers/{careerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /jobApplications/{applicationId} {
      // Prioritize Admin access for global listing and management
      allow read, list, write: if isAdmin();
      
      // User access for their own applications
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, list, write: if isAdmin();
    }

    match /meetings/{meetingId} {
      allow create: if true;
      allow read, list, write: if isAdmin();
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }
  }
}
