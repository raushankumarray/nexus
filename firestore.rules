
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NPB Media Security Protocol v5.2
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profiles & Carts: Restricted to the individual owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Job Applications: Candidates can manage their own
    match /jobApplications/{appId} {
      allow create: if isSignedIn();
      allow read, update, delete: if true; 
    }

    // Public & Admin Data
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /careers/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    // Lead Submissions & Consultation Requests
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    match /meetings/{meetingId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // System Notifications & Global Settings
    // Explicitly allow public read for global system flags (Maintenance/Popups)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Maintenance Logs Registry
    match /maintenanceLogs/{logId} {
      allow read, write: if true;
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
