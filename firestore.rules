
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Firebase Permission System - Decommissioned Admin Edition
     * Strictly enforces user ownership. No administrative overrides allowed.
     */

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USER PROFILES: Only the owner can manage their own data.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // CAREERS: Publicly readable, write access is completely disabled.
    match /careers/{careerId} {
      allow read: if true;
      allow write: if false; 
    }
    
    // JOB APPLICATIONS: Users can only see/manage their own applications.
    match /jobApplications/{applicationId} {
      allow create: if isSignedIn();
      allow read, list, write: if (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // INQUIRIES: Visitors can submit, but no one can read them via the client.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, list, write: if false;
    }

    // MEETINGS: Visitors can request, but no one can read them via the client.
    match /meetings/{meetingId} {
      allow create: if true;
      allow read, list, write: if false;
    }

    // CARTS: Strictly private shopping experience.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
