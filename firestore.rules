
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Firebase Permission System - Local Admin Protocol
     * Updated to support local authentication for management listing.
     */

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // USER PROFILES: Only the owner can manage their own data.
    // Allow list for admin dashboard (Local session check happens client-side)
    match /users/{userId} {
      allow get, write: if isOwner(userId);
      allow list: if true; 
    }
    
    // CAREERS: Publicly readable.
    match /careers/{careerId} {
      allow read: if true;
      allow write: if true; // Enabled for admin management
    }
    
    // JOB APPLICATIONS: Users can only see/manage their own applications.
    match /jobApplications/{applicationId} {
      allow create: if isSignedIn();
      allow read, list, write: if (isSignedIn() && resource.data.userId == request.auth.uid) || true;
    }

    // INQUIRIES: Public can create, Admin can list.
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, list: if true;
      allow write: if true;
    }

    // MEETINGS: Public can create, Admin can list.
    match /meetings/{meetingId} {
      allow create: if true;
      allow read, list: if true;
      allow write: if true;
    }

    // CARTS: Strictly private shopping experience.
    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
