
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /careers/{careerId} {
      allow read: if true;
      // Administrative write access disabled
    }
    
    match /jobApplications/{applicationId} {
      // User access only for their own applications
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read, list: if isSignedIn() && (resource.data.userId == request.auth.uid);
    }

    match /inquiries/{inquiryId} {
      allow create: if true;
      // Administrative read/list disabled
    }

    match /meetings/{meetingId} {
      allow create: if true;
      // Administrative read/list disabled
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}
