
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * NPB Media Core Security Logic
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Profiles & Carts: Restricted to the individual owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /carts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Job Applications: Candidate can manage their own, Admin access managed via dashboard
    match /jobApplications/{appId} {
      allow read, write: if isSignedIn() && appId.startsWith(request.auth.uid);
    }

    // Public Data: Everyone can view products and job openings
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    match /careers/{jobId} {
      allow read: if true;
      allow write: if false; // Admin only
    }

    // Public Submissions: Anyone can submit inquiries or meetings
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if false; // Admin only
    }

    match /meetings/{meetingId} {
      allow create: if true;
      allow read, update, delete: if false; // Admin only
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
