{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User profile information tied to Firebase Auth UID.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "fathersName": { "type": "string" },
        "mobile": { "type": "string" },
        "alternateMobile": { "type": "string", "description": "Secondary contact number." },
        "dob": { "type": "string" },
        "photoURL": { "type": "string", "description": "Base64 or URL for the profile picture." },
        "fullAddress": { "type": "string" },
        "block": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "country": { "type": "string" },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "qualification": { "type": "string" },
              "institution": { "type": "string" },
              "passingYear": { "type": "string" },
              "university": { "type": "string" },
              "subject": { "type": "string" },
              "percentage": { "type": "string" }
            }
          }
        },
        "resumeURL": { "type": "string", "description": "Base64 string of the user's PDF resume." },
        "idCardType": { "type": "string", "enum": ["Aadhar", "Pan", "Voter", "Driving"] },
        "idCardURL": { "type": "string", "description": "Base64 string of the user's ID card." },
        "socialLinks": {
          "type": "object",
          "properties": {
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "facebook": { "type": "string" },
            "portfolio": { "type": "string" }
          }
        },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "fullName", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "type": "object",
      "description": "Product/Service details managed by admins.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "title", "description", "isActive"]
    },
    "CareerOpportunity": {
      "title": "CareerOpportunity",
      "type": "object",
      "description": "Job listings managed by admins.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] }
      },
      "required": ["id", "title", "status"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "type": "object",
      "description": "Contact form submissions.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Public services/products."
    },
    "/careers/{careerId}": {
      "schema": { "$ref": "#/entities/CareerOpportunity" },
      "description": "Public career listings."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Private contact submissions."
    }
  }
}
