
{
  "entities": {
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Represents a software module or service offered in the marketplace.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "marketValue": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "color": { "type": "string" }
      },
      "required": ["id", "title", "marketValue"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Extended user information for professional and billing purposes.",
      "properties": {
        "fullName": { "type": "string" },
        "fathersName": { "type": "string" },
        "mobile": { "type": "string" },
        "dob": { "type": "string" },
        "fullAddress": { "type": "string" },
        "resumeURL": { "type": "string" },
        "photoURL": { "type": "string" }
      }
    },
    "Cart": {
      "title": "Cart",
      "type": "object",
      "description": "User's shopping cart for software module provisioning.",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Inquiry": {
      "title": "Inquiry",
      "type": "object",
      "description": "Lead captured from the contact form.",
      "properties": {
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "pending", "solved"] }
      }
    },
    "Meeting": {
      "title": "Meeting",
      "type": "object",
      "description": "A scheduled virtual consultation.",
      "properties": {
        "fullName": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string" },
        "meetingLink": { "type": "string" }
      }
    },
    "JobApplication": {
      "title": "JobApplication",
      "type": "object",
      "description": "A candidate's application for a career opening.",
      "properties": {
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "status": { "type": "string" },
        "applicantSnapshot": { "type": "object" }
      }
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "type": "object",
      "description": "Global application flags like maintenance mode and active popups.",
      "properties": {
        "maintenance": {
          "type": "object",
          "properties": {
            "isActive": { "type": "boolean" },
            "startTime": { "type": "string", "format": "date-time" },
            "endTime": { "type": "string", "format": "date-time" },
            "message": { "type": "string" }
          }
        },
        "popup": {
          "type": "object",
          "properties": {
            "isActive": { "type": "boolean" },
            "title": { "type": "string" },
            "displayMessage": { "type": "string" },
            "broadcastMessage": { "type": "string" },
            "type": { "type": "string" }
          }
        }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Public catalog of software modules."
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User professional profiles."
    },
    "/carts/{userId}": {
      "schema": "Cart",
      "description": "User shopping carts."
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Incoming lead requests."
    },
    "/meetings/{meetingId}": {
      "schema": "Meeting",
      "description": "Scheduled consultation sessions."
    },
    "/jobApplications/{appId}": {
      "schema": "JobApplication",
      "description": "Candidate job applications."
    },
    "/careers/{jobId}": {
      "schema": "object",
      "description": "Job opening details."
    },
    "/settings/system": {
      "schema": "SystemSettings",
      "description": "Global system status flags."
    }
  }
}
