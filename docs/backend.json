
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User profile information tied to Firebase Auth UID.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "fathersName": { "type": "string" },
        "mobile": { "type": "string" },
        "alternateMobile": { "type": "string" },
        "dob": { "type": "string" },
        "photoURL": { "type": "string" },
        "fullAddress": { "type": "string" },
        "block": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "country": { "type": "string" },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "qualification": { "type": "string" },
              "institution": { "type": "string" },
              "passingYear": { "type": "string" },
              "university": { "type": "string" },
              "subject": { "type": "string" },
              "percentage": { "type": "string" }
            }
          }
        },
        "resumeURL": { "type": "string" },
        "idCardType": { "type": "string" },
        "idCardURL": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "facebook": { "type": "string" },
            "portfolio": { "type": "string" }
          }
        },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "fullName"]
    },
    "CareerOpportunity": {
      "title": "CareerOpportunity",
      "type": "object",
      "description": "Job listings managed by admins.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "experience": { "type": "string" },
        "technologies": { "type": "string" },
        "qualification": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "closeDate": { "type": "string" }
      },
      "required": ["id", "title", "status"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "type": "object",
      "description": "User applications for career roles.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "experience": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "review", "screening", "shortlisted", "test_scheduled", "interview", "document_verification", "onboarding", "rejected"] },
        "applicantSnapshot": { "type": "object" },
        "hiringContext": {
          "type": "object",
          "properties": {
            "examLink": { "type": "string" },
            "examDate": { "type": "string" },
            "interviewLink": { "type": "string" },
            "interviewDate": { "type": "string" },
            "verificationFormLink": { "type": "string" },
            "deadline": { "type": "string" },
            "rejectionReason": { "type": "string" }
          }
        },
        "appliedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles."
    },
    "/careers/{careerId}": {
      "schema": { "$ref": "#/entities/CareerOpportunity" },
      "description": "Job listings."
    },
    "/jobApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "Candidate applications."
    }
  }
}
