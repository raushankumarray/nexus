
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "User profile information tied to Firebase Auth UID.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "fathersName": { "type": "string" },
        "mobile": { "type": "string" },
        "alternateMobile": { "type": "string" },
        "dob": { "type": "string" },
        "photoURL": { "type": "string" },
        "fullAddress": { "type": "string" },
        "block": { "type": "string" },
        "district": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "country": { "type": "string" },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "qualification": { "type": "string" },
              "institution": { "type": "string" },
              "passingYear": { "type": "string" },
              "university": { "type": "string" },
              "subject": { "type": "string" },
              "percentage": { "type": "string" }
            }
          }
        },
        "resumeURL": { "type": "string" },
        "idCardType": { "type": "string" },
        "idCardURL": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "facebook": { "type": "string" },
            "portfolio": { "type": "string" }
          }
        },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "fullName"]
    },
    "CareerOpportunity": {
      "title": "CareerOpportunity",
      "type": "object",
      "description": "Job listings managed by admins.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "salary": { "type": "string" },
        "location": { "type": "string" },
        "experience": { "type": "string" },
        "technologies": { "type": "string" },
        "education": { "type": "string" },
        "batchPassout": { "type": "string" },
        "lastDate": { "type": "string" },
        "category": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] }
      },
      "required": ["id", "title", "status"]
    },
    "JobApplication": {
      "title": "JobApplication",
      "type": "object",
      "description": "User applications for career roles.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["applied", "review", "shortlisting", "scheduled_test", "scheduled_interview", "decision", "document_verification", "selected", "onboarding"] },
        "appliedAt": { "type": "string", "format": "date-time" },
        "applicantSnapshot": { "type": "object" },
        "hiringContext": {
          "type": "object",
          "properties": {
            "testLink": { "type": "string" },
            "testDate": { "type": "string" },
            "testTime": { "type": "string" },
            "interviewLink": { "type": "string" },
            "interviewDate": { "type": "string" },
            "interviewTime": { "type": "string" },
            "decision": { "type": "string", "enum": ["qualified", "failed", "pending"] }
          }
        }
      }
    },
    "Inquiry": {
      "title": "Inquiry",
      "type": "object",
      "description": "General contact inquiries from visitors.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "pending", "solved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "message"]
    },
    "MeetingRequest": {
      "title": "MeetingRequest",
      "type": "object",
      "description": "Virtual consultation requests.",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "progress", "discussion", "completed", "canceled"] },
        "meetingLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "email", "date", "timeSlot"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles."
    },
    "/careers/{careerId}": {
      "schema": { "$ref": "#/entities/CareerOpportunity" },
      "description": "Job listings."
    },
    "/jobApplications/{applicationId}": {
      "schema": { "$ref": "#/entities/JobApplication" },
      "description": "Candidate applications."
    },
    "/inquiries/{inquiryId}": {
      "schema": { "$ref": "#/entities/Inquiry" },
      "description": "Contact form submissions."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/MeetingRequest" },
      "description": "Scheduled meeting requests."
    }
  }
}
